# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Flask ─────────────────────────────────────────────────────────────────────
# Any long random string — used to sign session cookies
SECRET_KEY=change-me-to-a-long-random-string

# Set to true for local development only — NEVER true in production
FLASK_DEBUG=false

# ── Azure MySQL ───────────────────────────────────────────────────────────────
DB_USER=your_db_user
DB_PASSWORD=your_db_password          # Use %40 instead of @ in the password
DB_HOST=your-server.mysql.database.azure.com
DB_PORT=3306
DB_NAME=your_database_name
DB_TEST=your_database_name_test

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG = verbose (Stripe SDK + HTTP request logs)
# INFO  = clean JSON only (default, use in production)
LOG_LEVEL=INFO

# ── Azure Blob Storage (optional — for product image uploads) ─────────────────
# Get from: Azure Portal → Storage Account → Access Keys → Connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_CONTAINER_NAME=your-container-name

# ── Stripe (test mode) ────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Get by running: stripe listen --forward-to localhost:5000/webhook/stripe
# For deployed app: get from Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
